{
  "name": "@dreamwidth/content",
  "version": "0.0.0-slice4",
  "private": true,
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "require": "./dist/contracts.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "css-tree": "3.2.1",
    "dompurify": "3.4.16",
    "jsdom": "30.1.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/css-tree": "3.2.0",
    "@types/jsdom": "30.0.0",
    "@types/node": "24.13.6",
    "typescript": "5.8.3"
  }
}
