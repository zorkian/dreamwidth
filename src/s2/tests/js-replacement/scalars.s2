layerinfo type = "core";
function main() {
    var string bytes = "猫é";
    print size $bytes;
    foreach var string byte ($bytes) { print "["+$byte+"]"; }
    var string reversed = reverse $bytes;
    print $reversed;
    print "|";
    print reverse $bytes;
    var int wide = 9007199254740993;
    var int max = 9223372036854775807;
    var int uv = 18446744073709551615;
    print "|"+$wide+"|"+($wide / 3)+"|"+($max / 3)+"|"+($max + 1)+"|"+($uv + 1);
    print "|"+(-7 % 3)+"|"+(7 % -3);
    var string[] values = ["first", "last"];
    print "|"+$values[$uv];
    foreach var string value ($values) { $value = $value + "!"; }
    print "|"+$values[0]+"|"+$values[1];
    var int remaining = 2;
    while ($remaining) { print "|"+$remaining; $remaining--; }
    for (var int counter = 2; $counter; $counter--) { print "|"+$counter; }
    var string{} keys = {$wide=>"wide", 9007199254740992=>"near"};
    print "|"+$keys{$wide}+"|"+$keys{9007199254740992};
    if ($wide == 9007199254740992) { print "|equal"; } else { print "|unequal"; }
}
