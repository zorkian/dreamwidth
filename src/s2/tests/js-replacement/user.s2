layerinfo type="user";
set greeting="custom";
set tone="blue";
function decorate(int value) : string {
    print "<b>custom</b>";
    var int total=0;
    foreach var int n (1..$value) { $total=$total+$n; }
    return "user:"+$total+":"+$*tone+":"+$*greeting;
}
